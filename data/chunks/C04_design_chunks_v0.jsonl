{"chunk_id": "C04-0057", "domain_id": "C04", "layer": "rule", "trust_tier": 3, "evidence_tier": null, "temporal_validity": "2026-09/계속", "tenant_id": "buyo_base", "tenant_scope": "base", "do_not_train_flag": false, "override_capability": "fully_overridable", "node_kind": "handling_rule", "illustrative": false, "product_scope": "early_biotech", "jurisdiction": "GLOBAL", "modality": null, "indication": null, "phase": null, "flag_hint": "neutral", "probability_basis": null, "pending": "formal_only", "source": {"type": "guidance", "title": "교안 3장 표 11.1", "year": 2026}, "source_record_id": "C04-D10", "dedup_key": "C04|C04-D10", "text": "[설계 플래그 C04-D10] 조건: phase = P1 ∧ population = patients ∧ disease_group = 항암. 문장: 항암 1상은 환자 대상이 일반적이며 용량 확장 코호트에서 초기 효능 신호를 함께 봅니다. 근거: 항암 1상 관행", "rule_id": "C04-D10", "condition": "phase = P1 ∧ population = patients ∧ disease_group = 항암"}
