{"chunk_id": "T02-0021", "domain_id": "T02", "layer": "rule", "trust_tier": 1, "evidence_tier": null, "temporal_validity": "2026-06/2027-06", "tenant_id": "buyo_base", "tenant_scope": "base", "do_not_train_flag": false, "override_capability": "immutable", "node_kind": "gatekeeper", "illustrative": false, "product_scope": "both", "jurisdiction": "GLOBAL", "modality": "cell_therapy", "indication": null, "phase": null, "flag_hint": "caution", "probability_basis": null, "source": {"type": "internal_corpus", "title": "T-SD3 FTO gatekeeper v1/v2", "year": 2026}, "source_record_id": "T-SD3-GK-M7-001", "text": "[M7 세포치료 게이트키퍼 — CAR 구조 IP (scFv·costim·signaling)] CAR 3요소(scFv 결합부 + costim CD28/4-1BB + CD3ζ 신호부) 각각 특허층. 구조 per se + 구성요소 + 제조공정 + 사용방법 다층. 게이트키퍼: MSK/Sloan Kettering (Sadelain): CD28+CD3ζ 2세대 CAR; St. Jude: 4-1BB costim CAR (US 8,399,645); Yeda/Weizmann (Eshhar): 초기 키메라 수용체(1990s); 🇰🇷 큐로셀·앱클론·GC셀: 안발셀(CD19) / AT101(신규 CD19 에피토프) / 등.", "dedup_key": "T02|T-SD3-GK-M7-001", "annual_refresh_required": true, "applies_to_all_modalities": false}
